<Window x:Class="MAXCloudSSD.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MAX CLOUD SSD" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#080D17">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="MAX CLOUD SSD" Foreground="White" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text=" - Win32 x86" Foreground="#EA580C" FontSize="11" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <StackPanel Margin="12">
                    <TextBlock Text="MAX CLOUD SSD" Foreground="#FF6B00" FontWeight="Bold" FontSize="14" Margin="0,0,0,16"/>
                    <TextBlock Text="• Dashboard" Foreground="#E2E8F0" FontSize="12" Margin="0,6"/>
                    <TextBlock Text="• My Files" Foreground="#94A3B8" FontSize="12" Margin="0,6"/>
                    <TextBlock Text="• Google Drive" Foreground="#94A3B8" FontSize="12" Margin="0,6"/>
                    <TextBlock Text="• Transfers" Foreground="#94A3B8" FontSize="12" Margin="0,6"/>
                    <TextBlock Text="• Settings" Foreground="#94A3B8" FontSize="12" Margin="0,6"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1" Background="#0B101D">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="MAX CLOUD SSD Engine Ready" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Windows 32-bit (win-x86) Native Build" Foreground="#EA580C" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Protected with Windows DPAPI and SQLite Local Storage" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
